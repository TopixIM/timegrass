{
  "name": "timegrass",
  "version": "0.1.0",
  "packageManager": "yarn@4.12.0",
  "description": "Cumulo Workflow",
  "engines": {
    "node": ">=24"
  },
  "main": "index.js",
  "scripts": {
    "check-client": "calcit calcit.cirru --compat-types --check-only && calcit calcit.cirru --compat-types test --tag :client --require-match",
    "check-server": "calcit calcit.cirru --entry server --compat-types --check-only && calcit calcit.cirru --entry server --compat-types test --require-match",
    "check-sync": "yarn check-client && yarn check-server && calcit calcit.cirru --compat-types analyze deprecated && yarn check-quality",
    "check-quality": "calcit calcit.cirru --compat-types analyze quality --baseline config/calcit-quality.cirru",
    "compile-page": "calcit calcit.cirru --compat-types js",
    "dev-page": "vite --force",
    "release-page": "vite build --base=./",
    "watch-page": "calcit calcit.cirru --compat-types -w js"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:TopixIM/timegrass.git"
  },
  "author": "jiyinyiyong",
  "license": "MIT",
  "dependencies": {
    "@calcit/procs": "0.14.16",
    "dayjs": "^1.11.23",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "bottom-tip": "^0.1.5",
    "copy-text-to-clipboard": "^3.2.2",
    "feather-icons": "^4.29.2",
    "url-parse": "^1.5.10",
    "vite": "^8.3.0"
  }
}
